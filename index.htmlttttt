    <!-- REAL-TIME HONEST LOGIC ENGINE WITH ULTRA-FAST INDEXEDDB & CACHE-FIRST ARCHITECTURE -->
    <script>
        const BLOG_ID = '2655100361109264849';
        const API_KEY = 'AIzaSyAIEywwPuNLMs73jjxHQjSAg0C1L3niXHQ';
        const PLAY_STORE_URL = "https://play.google.com/store/apps/dev?id=5695878942959714469";

        let favorites = JSON.parse(localStorage.getItem('wallhub_favs')) || [];
        let iskconMode = JSON.parse(localStorage.getItem('wallhub_iskcon_mode')) || false;
        let navHistoryStack = ['home'];
        let clearTargetAction = 'favorites';

        let loadedWallpapers = [];
        let selectedWallpaperUrl = "";
        let currentPreviewItem = null;
        let activeCategory = 'All';
        let exploreFilterType = 'all';

        let currentSlideIdx = 0;
        let slideInterval = null;

        // ==================== 0. SENIOR-GRADE INDEXEDDB STORAGE ENGINE ====================
        const DB_NAME = 'DevDarshan_Storage_v1';
        const DB_VERSION = 1;
        let dbInstance = null;

        function initIndexedDB() {
            return new Promise((resolve) => {
                if (!window.indexedDB) {
                    resolve(null);
                    return;
                }
                const request = indexedDB.open(DB_NAME, DB_VERSION);
                request.onupgradeneeded = function(e) {
                    const db = e.target.result;
                    if (!db.objectStoreNames.contains('wallpapers')) {
                        db.createObjectStore('wallpapers', { keyPath: 'category' });
                    }
                    if (!db.objectStoreNames.contains('imageCache')) {
                        db.createObjectStore('imageCache', { keyPath: 'url' });
                    }
                };
                request.onsuccess = function(e) {
                    dbInstance = e.target.result;
                    resolve(dbInstance);
                };
                request.onerror = function() {
                    resolve(null);
                };
            });
        }

        function saveToIndexedDB(storeName, data) {
            if (!dbInstance) return;
            try {
                const tx = dbInstance.transaction(storeName, 'readwrite');
                const store = tx.objectStore(storeName);
                store.put(data);
            } catch(e) {}
        }

        function getFromIndexedDB(storeName, key) {
            return new Promise((resolve) => {
                if (!dbInstance) {
                    resolve(null);
                    return;
                }
                try {
                    const tx = dbInstance.transaction(storeName, 'readonly');
                    const store = tx.objectStore(storeName);
                    const request = store.get(key);
                    request.onsuccess = function(e) {
                        resolve(e.target.result ? e.target.result.data : null);
                    };
                    request.onerror = function() {
                        resolve(null);
                    };
                } catch(e) {
                    resolve(null);
                }
            });
        }

        function clearEntireIndexedDB() {
            if (!dbInstance) return;
            try {
                const tx1 = dbInstance.transaction('wallpapers', 'readwrite');
                tx1.objectStore('wallpapers').clear();
                const tx2 = dbInstance.transaction('imageCache', 'readwrite');
                tx2.objectStore('imageCache').clear();
            } catch(e) {}
        }

