        // ==================== SMART HARDWARE BACK BUTTON NAVIGATION ENGINE ====================
        window.handleAndroidBack = function() {
            const clearModal = document.getElementById('confirm-clear-modal');
            if (clearModal && clearModal.style.display === 'flex') {
                closeClearModal();
                return true;
            }

            const preview = document.getElementById('preview-modal');
            if (preview && preview.style.display === 'flex') {
                closePreviewModal();
                return true;
            }

            const sheet = document.getElementById('wallpaper-sheet');
            if (sheet && sheet.classList.contains('active')) {
                closeWallpaperSheet();
                return true;
            }

            const about = document.getElementById('about-modal');
            if (about && about.style.display === 'flex') {
                closeAboutModal();
                return true;
            }

            const searchBar = document.getElementById('search-box-bar');
            if (searchBar && searchBar.style.display === 'block') {
                toggleSearchBox();
                return true;
            }

            if (navHistoryStack.length > 1) {
                navHistoryStack.pop();
                const previousNav = navHistoryStack[navHistoryStack.length - 1] || 'home';
                executeNavSwitch(previousNav, false);
                return true;
            }

            return false;
        };

        window.addEventListener('popstate', () => {
            window.handleAndroidBack();
        });

        // ==================== DEDICATED ISKCON DEVOTEE MODE ====================
        function toggleIskconDevoteeMode() {
            iskconMode = !iskconMode;
            localStorage.setItem('wallhub_iskcon_mode', JSON.stringify(iskconMode));
            applyIskconDevoteeModeUI(true);
            if (typeof gtag === 'function') {
                gtag('event', 'toggle_iskcon_mode', { is_active: iskconMode });
            }
        }

        function applyIskconDevoteeModeUI(showFeedback) {
            const btn = document.getElementById('iskcon-toggle-btn');
            const pillText = document.getElementById('iskcon-pill-text');
            const menuBadge = document.getElementById('iskcon-status-badge');
            const tagline = document.getElementById('header-tagline');
            const heading = document.getElementById('darshan-banner-heading');

            if (iskconMode) {
                btn.style.background = 'linear-gradient(135deg, #FF9933, #FF5500)';
                btn.style.color = '#FFFFFF';
                pillText.innerText = 'ISKCON ON';
                if (menuBadge) menuBadge.innerText = 'ACTIVE';
                if (tagline) tagline.innerText = 'DevDarshan • Prabhupada Grace 🌿';
                if (heading) heading.innerText = 'Srila Prabhupada & Gaura Darshan';
                if (showFeedback) showToast("ISKCON Devotee Mode Activated! 🌿");
            } else {
                btn.style.background = 'linear-gradient(135deg, var(--iskcon-saffron), #D97706)';
                btn.style.color = '#000000';
                pillText.innerText = 'ISKCON';
                if (menuBadge) menuBadge.innerText = 'OFF';
                if (tagline) tagline.innerText = 'Hindu Wallpaper • Divine Visuals';
                if (heading) heading.innerText = "Today's Divine Darshan";
                if (showFeedback) showToast("Sanatan Mode Active");
            }
        }

        // ==================== AUTO BANNER SLIDER ====================
        function startHeroAutoSlider() {
            clearInterval(slideInterval);
            slideInterval = setInterval(() => {
                const track = document.getElementById('carousel-track');
                const dots = document.querySelectorAll('.carousel-dot');
                const totalSlides = 3;
                
                currentSlideIdx = (currentSlideIdx + 1) % totalSlides;
                if (track) {
                    track.style.transform = `translateX(-${currentSlideIdx * 100}%)`;
                }
                dots.forEach((dot, idx) => {
                    dot.classList.toggle('active', idx === currentSlideIdx);
                });
            }, 4500);
        }

        // ==================== SUPER-FAST INDEXEDDB & CACHE-FIRST FETCHER ====================
        async function fetchWallpapers(category) {
            activeCategory = category;
            const cacheKey = 'cache_category_' + category;

            // 1. FAST PATH: Check IndexedDB first, then localStorage (Instant 0.01 sec UI render)
            let cached = await getFromIndexedDB('wallpapers', category);
            if (!cached) {
                const localStr = localStorage.getItem(cacheKey);
                if (localStr) {
                    try { cached = JSON.parse(localStr); } catch(e) {}
                }
            }

            if (cached && cached.length > 0) {
                loadedWallpapers = cached;
                showLoader(false);
                renderHomeView();
                renderExploreView();
            } else {
                showLoader(true);
            }

            // 2. NETWORK PATH (STALE-WHILE-REVALIDATE): Silently fetch freshest data from Google Blogger API
            let apiUrl = `https://www.googleapis.com/blogger/v3/blogs/${BLOG_ID}/posts?key=${API_KEY}&maxResults=50`;
            if (category !== 'All' && category !== 'Live') {
                apiUrl += `&labels=${encodeURIComponent(category)}`;
            }

            fetch(apiUrl)
                .then(res => res.json())
                .then(data => {
                    showLoader(false);
                    if (data && data.items && data.items.length > 0) {
                        let fresh = parseBloggerPosts(data.items, category);
                        if (category === 'Live') {
                            fresh = fresh.filter(item => item.isLive);
                        }
                        
                        loadedWallpapers = fresh;
                        
                        // Save to both IndexedDB and localStorage for instant recovery
                        saveToIndexedDB('wallpapers', { category: category, data: fresh });
                        try {
                            localStorage.setItem(cacheKey, JSON.stringify(fresh));
                        } catch(e) {}

                        renderHomeView();
                        renderExploreView();
                    } else if (!cached || cached.length === 0) {
                        loadedWallpapers = filterFallbackByCategory(category);
                        renderHomeView();
                        renderExploreView();
                    }
                })
                .catch(() => {
                    showLoader(false);
                    if (!cached || cached.length === 0) {
                        loadedWallpapers = filterFallbackByCategory(category);
                        renderHomeView();
                        renderExploreView();
                    }
                });
        }

        // Crisp High-Resolution Post Parser (Fixes low-res pixelated blur)
        function parseBloggerPosts(items, defaultCat) {
            let parsed = [];
            items.forEach((post, idx) => {
                let tempDiv = document.createElement('div');
                tempDiv.innerHTML = post.content || '';
                let imgTag = tempDiv.querySelector('img');
                
                if (imgTag && imgTag.src) {
                    let rawSrc = imgTag.src;
                    let thumb = rawSrc;
                    let hd = rawSrc;

                    // Robust Google User Content Parser (Supports /s..., /w..., =s0)
                    if (rawSrc.includes('/s') || rawSrc.includes('/w')) {
                        thumb = rawSrc.replace(/\/s\d+.*?\//, "/s800/").replace(/\/w\d+-h\d+.*?\//, "/w800/");
                        hd = rawSrc.replace(/\/s\d+.*?\//, "/s1600/").replace(/\/w\d+-h\d+.*?\//, "/s0/");
                    } else if (rawSrc.includes('=')) {
                        thumb = rawSrc.split('=')[0] + '=s800';
                        hd = rawSrc.split('=')[0] + '=s1600';
                    }
                    
                    let labels = (post.labels || []).map(l => l.toLowerCase());
                    let titleLower = (post.title || '').toLowerCase();
                    
                    let isLive = labels.includes('live') || 
                                 labels.includes('animated') || 
                                 titleLower.includes('live') || 
                                 hd.includes('.gif');

                    parsed.push({
                        id: post.id || ('post_' + idx),
                        title: post.title || 'DevDarshan Sacred Visual',
                        category: defaultCat === 'All' ? (labels[0] || 'Krishna') : defaultCat,
                        thumb: thumb,
                        hd: hd,
                        isLive: isLive,
                        liveMedia: hd
                    });
                }
            });
            return parsed.length > 0 ? parsed : FALLBACK_WALLPAPERS;
        }

        function filterFallbackByCategory(cat) {
            if (cat === 'All') return FALLBACK_WALLPAPERS;
            if (cat === 'Live') return FALLBACK_WALLPAPERS.filter(item => item.isLive);
            return FALLBACK_WALLPAPERS.filter(item => item.category.toLowerCase() === cat.toLowerCase()) || FALLBACK_WALLPAPERS;
        }

        // ==================== RENDERING WALLPAPERS ====================
        function renderHomeView() {
            const grid = document.getElementById('home-wallpaper-grid');
            if (!grid) return;
            grid.innerHTML = '';

            if (loadedWallpapers.length === 0) {
                grid.innerHTML = `<div class="empty-placeholder"><i class="bi bi-image"></i><h4>No Wallpapers Found</h4></div>`;
                return;
            }

            loadedWallpapers.forEach(item => {
                grid.appendChild(createWallpaperCardElement(item));
            });
        }

        function renderExploreView() {
            const grid = document.getElementById('explore-wallpaper-grid');
            if (!grid) return;
            grid.innerHTML = '';

            let filtered = loadedWallpapers;
            if (exploreFilterType === 'live') {
                filtered = loadedWallpapers.filter(item => item.isLive);
            } else if (exploreFilterType === 'normal') {
                filtered = loadedWallpapers.filter(item => !item.isLive);
            }

            filtered.forEach(item => {
                grid.appendChild(createWallpaperCardElement(item));
            });
        }

        function renderFavoritesView() {
            const grid = document.getElementById('favorites-wallpaper-grid');
            const empty = document.getElementById('fav-empty-state');
            if (!grid || !empty) return;
            grid.innerHTML = '';

            if (!favorites || favorites.length === 0) {
                empty.style.display = 'block';
                return;
            }
            empty.style.display = 'none';

            favorites.forEach((favItem, idx) => {
                let item = typeof favItem === 'string' ? {
                    id: 'fav_' + idx,
                    title: 'Favorite Wallpaper',
                    thumb: favItem,
                    hd: favItem,
                    isLive: false
                } : favItem;
                grid.appendChild(createWallpaperCardElement(item));
            });
        }

        function createWallpaperCardElement(item) {
            const isFav = isUrlFavorite(item.hd);
            const card = document.createElement('div');
            card.className = 'card-wall';

            const setActionCode = item.isLive 
                ? `executeSetLiveWallpaper('${item.hd}')` 
                : `promptWallpaperOptions('${item.hd}')`;

            card.innerHTML = `
                <div class="card-thumb-wrap" onclick='handleCardClick(${JSON.stringify(item)})'>
                    ${item.isLive ? '<div class="badge-live"><span class="badge-live-pulse"></span> LIVE</div>' : ''}
                    <img src="${item.thumb}" loading="lazy" alt="${item.title}">
                    <div class="card-footer-pill" onclick="event.stopPropagation()">
                        <button class="pill-btn btn-fav ${isFav ? 'active' : ''}" onclick="toggleFavoriteAction(this, '${item.hd}')">
                            <i class="bi ${isFav ? 'bi-heart-fill' : 'bi-heart'}"></i>
                        </button>
                        <button class="pill-btn-set ${item.isLive ? 'is-live-btn' : ''}" onclick="${setActionCode}">
                            ${item.isLive ? 'SET LIVE' : 'SET'}
                        </button>
                        <button class="pill-btn" onclick="directDownloadToGallery('${item.hd}')">
                            <i class="bi bi-download"></i>
                        </button>
                    </div>
                </div>
            `;
            return card;
        }

        function handleCardClick(item) {
            openPreview(item);
        }

        // ==================== PREVIEW MODAL (SMOOTH ZERO-BLUR SYSTEM) ====================
        function openPreview(item) {
            currentPreviewItem = item;
            selectedWallpaperUrl = item.hd;
            const modal = document.getElementById('preview-modal');
            const posterImg = document.getElementById('preview-poster');
            const liveMedia = document.getElementById('preview-live-media');
            const livePill = document.getElementById('preview-live-pill');
            const setBtn = document.getElementById('preview-set-btn');
            const favBtn = document.getElementById('preview-fav-btn');

            posterImg.src = item.hd || item.thumb;
            liveMedia.classList.remove('loaded');
            liveMedia.src = '';

            if (item.isLive) {
                livePill.style.display = 'flex';
                setBtn.className = 'btn-set-wallpaper-main is-live';
                setBtn.innerHTML = '<i class="bi bi-play-circle-fill"></i> Set Live Wallpaper';
                
                liveMedia.onload = () => {
                    liveMedia.classList.add('loaded');
                };
                liveMedia.src = item.liveMedia || item.hd;
            } else {
                livePill.style.display = 'none';
                setBtn.className = 'btn-set-wallpaper-main';
                setBtn.innerHTML = '<i class="bi bi-image"></i> Set Wallpaper';
            }

            if (favBtn) {
                const isFav = isUrlFavorite(item.hd);
                favBtn.innerHTML = `<i class="bi ${isFav ? 'bi-heart-fill text-danger' : 'bi-heart'}"></i>`;
                favBtn.style.color = isFav ? 'var(--live-crimson)' : '#fff';
            }

            modal.style.display = 'flex';
            history.pushState({ modal: 'preview' }, '');

            if (typeof gtag === 'function') {
                gtag('event', 'view_wallpaper', { title: item.title, category: item.category });
            }
        }

        function closePreviewModal() {
            const modal = document.getElementById('preview-modal');
            const liveMedia = document.getElementById('preview-live-media');
            if (liveMedia) {
                liveMedia.classList.remove('loaded');
                liveMedia.src = '';
            }
            if (modal) modal.style.display = 'none';
            currentPreviewItem = null;
        }

        function togglePreviewFav() {
            if (!currentPreviewItem) return;
            const favBtn = document.getElementById('preview-fav-btn');
            toggleFavoriteAction(favBtn, currentPreviewItem.hd);
        }

        function handlePreviewSetClick() {
            if (!currentPreviewItem) return;
            if (currentPreviewItem.isLive) {
                executeSetLiveWallpaper(currentPreviewItem.hd);
            } else {
                promptWallpaperOptions(currentPreviewItem.hd);
            }
        }

        // ==================== INSTANT MAGIC DEVOTIONAL LOADER SYSTEM ====================
        function openMagicLoader(statusMsg) {
            const overlay = document.getElementById('magic-loader-overlay');
            const pctText = document.getElementById('magic-pct-text');
            const statusText = document.getElementById('magic-status-text');
            const fill = document.getElementById('magic-bar-fill');
            const ring = document.getElementById('magic-outer-ring');

            pctText.innerText = '10%';
            pctText.style.color = '#FFFFFF';
            fill.style.width = '10%';
            ring.style.borderColor = 'var(--gold-primary)';
            statusText.style.color = 'var(--text-muted)';
            statusText.innerText = statusMsg || "⚡ Connecting to High-Speed CDN...";

            overlay.style.display = 'flex';
        }

        function promptWallpaperOptions(url) {
            selectedWallpaperUrl = url;
            document.getElementById('sheet-backdrop').style.display = 'block';
            document.getElementById('wallpaper-sheet').classList.add('active');
            history.pushState({ modal: 'sheet' }, '');
        }

        function closeWallpaperSheet() {
            document.getElementById('sheet-backdrop').style.display = 'none';
            document.getElementById('wallpaper-sheet').classList.remove('active');
        }

        // ⚡ INSTANT TRIGGER (NO ARTIFICIAL DELAY)
        function executeSetWallpaper(targetType) {
            closeWallpaperSheet();
            if (!selectedWallpaperUrl) return;

            openMagicLoader("⚡ Applying Wallpaper Instantly...");

            if (typeof gtag === 'function') {
                gtag('event', 'set_wallpaper_target', {
                    target_type: targetType,
                    wallpaper_url: selectedWallpaperUrl
                });
            }

            if (window.Android && typeof window.Android.setWallpaper === 'function') {
                window.Android.setWallpaper(selectedWallpaperUrl, targetType);
            } else {
                simulateInstantNativeProgress("🎉 Wallpaper Applied Successfully!");
            }
        }

        function executeSetLiveWallpaper(url) {
            openMagicLoader("🎬 Launching Live Wallpaper Engine...");

            if (typeof gtag === 'function') {
                gtag('event', 'set_live_wallpaper', { wallpaper_url: url });
            }

            if (window.Android && typeof window.Android.setWallpaper === 'function') {
                window.Android.setWallpaper(url, 3);
            } else {
                simulateInstantNativeProgress("🎉 Live Wallpaper Applied!");
            }
        }

        // REAL-TIME PROGRESS LISTENER: DIRECT FROM JAVA
        window.updateProgress = function(percent, statusMessage, isDone, isError) {
            const overlay = document.getElementById('magic-loader-overlay');
            const pctText = document.getElementById('magic-pct-text');
            const statusText = document.getElementById('magic-status-text');
            const fill = document.getElementById('magic-bar-fill');
            const ring = document.getElementById('magic-outer-ring');

            pctText.innerText = percent + '%';
            if (statusMessage) statusText.innerText = statusMessage;
            fill.style.width = percent + '%';

            if (isError) {
                pctText.innerText = 'Failed';
                pctText.style.color = '#FF4757';
                ring.style.borderColor = '#FF4757';
                statusText.style.color = '#FF8080';
                
                setTimeout(() => { 
                    overlay.style.display = 'none'; 
                    showToast(statusMessage || "Error setting wallpaper.");
                }, 1800);
            } 
            else if (isDone) {
                pctText.innerText = '100%';
                pctText.style.color = '#34D399';
                ring.style.borderColor = '#34D399';
                fill.style.width = '100%';
                setTimeout(() => { 
                    overlay.style.display = 'none'; 
                    showToast("Wallpaper Applied Successfully! ✨");
                }, 800);
            }
        };

        function simulateInstantNativeProgress(msg) {
            window.updateProgress(45, "📥 Downloading Ultra HD...", false, false);
            setTimeout(() => { window.updateProgress(85, "🎨 Rendering Display...", false, false); }, 200);
            setTimeout(() => { window.updateProgress(100, msg, true, false); }, 500);
        }

        // ==================== INSTANT GALLERY DOWNLOAD & MEDIA API ====================
        function directDownloadToGallery(url) {
            openMagicLoader("⬇️ Downloading Ultra HD to Gallery...");

            if (typeof gtag === 'function') {
                gtag('event', 'download_wallpaper', { wallpaper_url: url });
            }

            if (window.Android && typeof window.Android.downloadFile === 'function') {
                window.Android.downloadFile(url);
                window.updateProgress(100, "🎉 Saved to Downloads / Gallery!", true, false);
            } else {
                fetch(url)
                    .then(res => res.blob())
                    .then(blob => {
                        const blobUrl = window.URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.style.display = 'none';
                        a.href = blobUrl;
                        a.download = `DevDarshan_${Date.now()}.jpg`;
                        document.body.appendChild(a);
                        a.click();
                        window.URL.revokeObjectURL(blobUrl);
                        document.body.removeChild(a);
                        window.updateProgress(100, "🎉 Downloaded to Gallery!", true, false);
                    })
                    .catch(() => {
                        window.updateProgress(0, "Download failed", false, true);
                    });
            }
        }

        function downloadCurrentWallpaper() {
            if (selectedWallpaperUrl) directDownloadToGallery(selectedWallpaperUrl);
        }

        function showToast(msg) {
            const toast = document.getElementById('toast-notification');
            const text = document.getElementById('toast-msg');
            if (toast && text) {
                text.innerText = msg;
                toast.classList.add('show');
                setTimeout(() => { 
                    toast.classList.remove('show'); 
                }, 2600);
            }
        }

        // ==================== SUPERCHARGED VIRAL WHATSAPP & SOCIAL SHARE ====================
        function formatViralDevotionalMessage(title, quote) {
            const dateStr = new Date().toLocaleDateString('hi-IN', { weekday: 'long', day: 'numeric', month: 'long' });
            return `🌸 *जय श्री कृष्ण • ॐ नमः शिवाय* 🌸\n` +
                   `✨ *${title || 'आज का पावन दिव्य दर्शन'}*\n` +
                   `📅 *${dateStr}*\n\n` +
                   `"${quote || 'ईश्वर के चरणों में ही परम शांति और सच्चा आनंद है।'}"\n\n` +
                   `📲 *रोज़ाना 4K दर्शन, वॉलपेपर और WhatsApp स्टेटस पाने के लिए अभी DevDarshan App डाउनलोड करें:* 👇\n` +
                   `👉 ${PLAY_STORE_URL}`;
        }

        function shareViralWhatsApp(imageUrl, title, quote) {
            const text = formatViralDevotionalMessage(title, quote);
            
            if (typeof gtag === 'function') {
                gtag('event', 'share_whatsapp', { title: title });
            }

            if (window.Android && typeof window.Android.shareToWhatsApp === 'function') {
                window.Android.shareToWhatsApp(imageUrl, text);
            } else {
                const waUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(text + '\n\n' + imageUrl)}`;
                window.open(waUrl, '_blank');
            }
        }

        function shareCurrentWallpaper() {
            const title = currentPreviewItem ? currentPreviewItem.title : "DevDarshan Wallpaper";
            const text = formatViralDevotionalMessage(title, currentPreviewItem ? currentPreviewItem.mantra : null);

            if (typeof gtag === 'function') {
                gtag('event', 'share_general', { title: title });
            }

            if (window.Android && typeof window.Android.shareGeneral === 'function') {
                window.Android.shareGeneral(selectedWallpaperUrl, text);
            } else if (navigator.share) {
                navigator.share({ title: title, text: text, url: selectedWallpaperUrl }).catch(() => {});
            } else {
                shareToWhatsAppCurrent();
            }
        }

        function shareToWhatsAppCurrent() {
            if (!selectedWallpaperUrl) return;
            const title = currentPreviewItem ? currentPreviewItem.title : "DevDarshan Divine Darshan";
            shareViralWhatsApp(selectedWallpaperUrl, title, currentPreviewItem ? currentPreviewItem.mantra : null);
        }

        function triggerNativeShare() {
            const promoText = `🌿 *DevDarshan App - हिन्दू देवी-देवता एवं इस्कॉन 4K वॉलपेपर*\n\n` +
                              `हर रोज़ पाएं नए दर्शन, शुभ प्रभात स्टेटस, गीता ज्ञान व लाइव वॉलपेपर 100% फ्री!\n\n` +
                              `📲 *Play Store से अभी इनस्टॉल करें:* 👇\n${PLAY_STORE_URL}`;

            if (typeof gtag === 'function') {
                gtag('event', 'share_app_promo');
            }

            if (window.Android && typeof window.Android.shareApp === 'function') {
                window.Android.shareApp();
            } else if (navigator.share) {
                navigator.share({ title: 'DevDarshan App', text: promoText, url: PLAY_STORE_URL }).catch(() => {});
            } else {
                window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(promoText)}`, '_blank');
            }
        }

        function triggerNativeRate() {
            if (typeof gtag === 'function') {
                gtag('event', 'rate_app_click');
            }

            if (window.Android && typeof window.Android.rateApp === 'function') {
                window.Android.rateApp();
            } else {
                window.open(PLAY_STORE_URL, "_blank");
            }
        }

        function triggerMoreApps() {
            if (window.Android && typeof window.Android.openBrowser === 'function') {
                window.Android.openBrowser(PLAY_STORE_URL);
            } else {
                window.open(PLAY_STORE_URL, "_blank");
            }
        }

        function openAboutModal() {
            document.getElementById('about-modal').style.display = 'flex';
            history.pushState({ modal: 'about' }, '');
        }

        function closeAboutModal() {
            document.getElementById('about-modal').style.display = 'none';
        }

        // ==================== FAVORITES & CUSTOM IN-APP CLEAR ENGINE ====================
        function isUrlFavorite(url) {
            return favorites.includes(url);
        }

        function toggleFavoriteAction(btnElement, url) {
            const index = favorites.indexOf(url);
            if (index === -1) {
                favorites.push(url);
                if (btnElement) {
                    btnElement.classList.add('active');
                    btnElement.innerHTML = '<i class="bi bi-heart-fill text-danger"></i>';
                }
                showToast("Added to Favorites ❤️");
                if (typeof gtag === 'function') {
                    gtag('event', 'favorite_added', { url: url });
                }
            } else {
                favorites.splice(index, 1);
                if (btnElement) {
                    btnElement.classList.remove('active');
                    btnElement.innerHTML = '<i class="bi bi-heart"></i>';
                }
                showToast("Removed from Favorites");
                if (typeof gtag === 'function') {
                    gtag('event', 'favorite_removed', { url: url });
                }
            }
            localStorage.setItem('wallhub_favs', JSON.stringify(favorites));

            if (document.getElementById('view-favorites').classList.contains('active-page')) {
                renderFavoritesView();
            }
        }

        function openClearModal(type) {
            clearTargetAction = type;
            const modal = document.getElementById('confirm-clear-modal');
            const title = document.getElementById('confirm-clear-title');
            const desc = document.getElementById('confirm-clear-desc');

            if (type === 'favorites') {
                title.innerText = "Clear All Favorites?";
                desc.innerText = "Do you want to clear your saved favorite wallpapers?";
            } else {
                title.innerText = "Clear Favorites & Cache?";
                desc.innerText = "This will clear your saved favorites and reset local app preferences.";
            }

            modal.style.display = 'flex';
            history.pushState({ modal: 'clear_confirm' }, '');
        }

        function closeClearModal() {
            const modal = document.getElementById('confirm-clear-modal');
            if (modal) modal.style.display = 'none';
        }

        function executeConfirmedClear() {
            closeClearModal();
            favorites = [];
            localStorage.removeItem('wallhub_favs');
            localStorage.removeItem('wallhub_cached_registry');

            // Clear all category caches in localStorage & IndexedDB
            Object.keys(localStorage).forEach(key => {
                if (key.startsWith('cache_category_')) {
                    localStorage.removeItem(key);
                }
            });
            clearEntireIndexedDB();

            document.querySelectorAll('.pill-btn.btn-fav').forEach(btn => {
                btn.classList.remove('active');
                btn.innerHTML = '<i class="bi bi-heart"></i>';
            });

            renderFavoritesView();

            if (clearTargetAction === 'all') {
                showToast("All Favorites & Cache Cleared ✨");
            } else {
                showToast("Favorites Cleared Successfully ✨");
            }
        }

        // ==================== NAVIGATION & ROUTING ====================
        function switchNav(navId) {
            executeNavSwitch(navId, true);
        }

        function executeNavSwitch(navId, pushToHistory) {
            if (pushToHistory && navHistoryStack[navHistoryStack.length - 1] !== navId) {
                navHistoryStack.push(navId);
            }

            document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
            const activeNavItem = document.getElementById('nav-' + navId);
            if (activeNavItem) activeNavItem.classList.add('active');

            document.querySelectorAll('.view-page').forEach(page => page.classList.remove('active-page'));
            const targetPage = document.getElementById('view-' + navId);
            if (targetPage) targetPage.classList.add('active-page');

            window.scrollTo({ top: 0, behavior: 'smooth' });

            if (navId === 'favorites') renderFavoritesView();
            else if (navId === 'explore') renderExploreView();

            if (typeof gtag === 'function') {
                gtag('event', 'screen_view', { app_screen: navId });
            }
        }

        function selectCategory(category, chipElem) {
            document.querySelectorAll('.avatar-cat-item').forEach(el => el.classList.remove('active'));
            if (chipElem) chipElem.classList.add('active');
            
            const title = document.getElementById('home-grid-title');
            if (title) title.innerText = category === 'All' ? 'Latest Wallpapers' : `${category} Wallpapers`;
            
            if (typeof gtag === 'function') {
                gtag('event', 'select_category', { category_name: category });
            }

            fetchWallpapers(category);
        }

        function setExploreFilter(type, tabElem) {
            exploreFilterType = type;
            document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
            if (tabElem) tabElem.classList.add('active');
            renderExploreView();
        }

        function filterByFestival(festName) {
            switchNav('home');
            selectCategory(festName, null);
        }

        function toggleSearchBox() {
            const bar = document.getElementById('search-box-bar');
            const input = document.getElementById('main-search-input');
            if (bar.style.display === 'block') {
                bar.style.display = 'none';
            } else {
                bar.style.display = 'block';
                input.focus();
            }
        }

        function handleSearchInput(e) {
            const query = e.target.value.trim().toLowerCase();
            if (e.key === 'Enter' && query.length > 1) {
                showLoader(true);
                toggleSearchBox();
                switchNav('home');
                const title = document.getElementById('home-grid-title');
                if (title) title.innerText = `Search: "${query}"`;

                if (typeof gtag === 'function') {
                    gtag('event', 'search', { search_term: query });
                }

                let apiUrl = `https://www.googleapis.com/blogger/v3/blogs/${BLOG_ID}/posts/search?q=${encodeURIComponent(query)}&key=${API_KEY}`;
                fetch(apiUrl)
                    .then(res => res.json())
                    .then(data => {
                        showLoader(false);
                        if (data && data.items && data.items.length > 0) {
                            loadedWallpapers = parseBloggerPosts(data.items, query);
                        } else {
                            loadedWallpapers = FALLBACK_WALLPAPERS.filter(i => i.title.toLowerCase().includes(query));
                        }
                        renderHomeView();
                    })
                    .catch(() => {
                        showLoader(false);
                        loadedWallpapers = FALLBACK_WALLPAPERS.filter(i => i.title.toLowerCase().includes(query));
                        renderHomeView();
                    });
            }
        }

        function showLoader(visible) {
            const el = document.getElementById('loader-overlay');
            if (el) el.style.display = visible ? 'flex' : 'none';
        }

        function showInfoToast() {
            if (currentPreviewItem) {
                alert(`Title: ${currentPreviewItem.title}\nCategory: ${currentPreviewItem.category || 'Sacred'}\nType: ${currentPreviewItem.isLive ? 'Live Wallpaper' : 'Ultra HD'}`);
            }
        }
    </script>
</body>
</html>
