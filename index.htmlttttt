<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
    <title>DevDarshan: Hindu Wallpaper</title>
    
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Y16GLTS9W1"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-Y16GLTS9W1');
    </script>

    <!-- Icons & Typography -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-base: #070A10;
            --bg-surface: #0E1422;
            --bg-card: #141C2E;
            --bg-card-elevated: #1B253D;
            --gold-primary: #E5A93C;
            --gold-light: #F6C85E;
            --gold-glow: rgba(229, 169, 60, 0.35);
            --live-crimson: #FF2E63;
            --live-glow: rgba(255, 46, 99, 0.45);
            --iskcon-saffron: #FF9933;
            --text-main: #FFFFFF;
            --text-muted: #94A3B8;
            --text-sub: #64748B;
            --border-subtle: rgba(255, 255, 255, 0.08);
            --border-gold: rgba(229, 169, 60, 0.35);
            --radius-sm: 8px;
            --radius-md: 14px;
            --radius-lg: 20px;
            --radius-xl: 26px;
            --safe-bottom: env(safe-area-inset-bottom, 0px);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-tap-highlight-color: transparent;
            user-select: none;
        }

        body {
            background-color: var(--bg-base);
            color: var(--text-main);
            font-family: 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
            padding-bottom: calc(72px + var(--safe-bottom));
        }

        .font-devotional {
            font-family: 'Playfair Display', serif;
        }

        /* ==================== 1. TOAST NOTIFICATION ==================== */
        #toast-notification {
            position: fixed;
            top: -120px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(14, 20, 34, 0.98);
            border: 1px solid var(--border-gold);
            color: #fff;
            padding: 10px 22px;
            border-radius: 30px;
            font-size: 12.5px;
            font-weight: 600;
            display: none;
            align-items: center;
            gap: 8px;
            z-index: 99999;
            box-shadow: 0 10px 30px rgba(0,0,0,0.8), 0 0 15px var(--gold-glow);
            transition: all 0.35s cubic-bezier(0.18, 0.89, 0.32, 1.28);
            pointer-events: none;
        }
        #toast-notification.show {
            display: flex;
            top: 24px;
        }

        /* ==================== 2. TOP APP HEADER ==================== */
        .app-header {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: rgba(7, 10, 16, 0.96);
            backdrop-filter: blur(15px);
            border-bottom: 1px solid var(--border-subtle);
            padding: 12px 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .header-brand {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .brand-logo-wrap {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            border: 1.5px solid var(--gold-primary);
            box-shadow: 0 0 14px var(--gold-glow);
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #0B101D;
            flex-shrink: 0;
        }
        .brand-logo-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
        .brand-text h1 {
            font-size: 17.5px;
            font-weight: 700;
            color: #fff;
            margin: 0;
            line-height: 1.15;
            letter-spacing: 0.2px;
        }
        .brand-text p {
            font-size: 10px;
            color: var(--gold-primary);
            margin: 0;
            font-weight: 600;
            letter-spacing: 0.4px;
        }
        .header-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .icon-btn-round {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--bg-surface);
            border: 1px solid var(--border-subtle);
            color: var(--text-main);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
        }
        .icon-btn-round:active {
            transform: scale(0.92);
            border-color: var(--gold-primary);
        }
        .badge-iskcon-pill {
            background: linear-gradient(135deg, var(--iskcon-saffron), #D97706);
            color: #000;
            font-size: 10px;
            font-weight: 800;
            padding: 4px 10px;
            border-radius: 20px;
            cursor: pointer;
            box-shadow: 0 2px 8px rgba(255, 153, 51, 0.4);
            display: flex;
            align-items: center;
            gap: 4px;
        }

        /* --- SEARCH SLIDER --- */
        #search-box-bar {
            display: none;
            background: var(--bg-surface);
            padding: 10px 18px;
            border-bottom: 1px solid var(--border-subtle);
        }
        .search-inner {
            display: flex;
            align-items: center;
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid var(--border-subtle);
            border-radius: 12px;
            padding: 0 12px;
        }
        .search-inner:focus-within {
            border-color: var(--gold-primary);
        }
        .search-inner input {
            flex: 1;
            background: transparent;
            border: none;
            outline: none;
            color: #fff;
            padding: 10px 8px;
            font-size: 14px;
        }

        /* ==================== 3. AUTO-SLIDING BANNER ==================== */
        .slider-section {
            padding: 14px 18px 6px;
        }
        .slider-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 10px;
        }
        .slider-header h3 {
            font-size: 13.5px;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            color: var(--gold-light);
            font-weight: 700;
        }
        .slider-header span {
            font-size: 11px;
            color: var(--text-muted);
        }

        .hero-carousel-container {
            position: relative;
            width: 100%;
            height: 230px;
            border-radius: var(--radius-lg);
            overflow: hidden;
            background: #0B0F19;
            border: 1px solid var(--border-gold);
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            pointer-events: none;
        }
        .carousel-track {
            display: flex;
            width: 100%;
            height: 100%;
            transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
        }
        .carousel-slide {
            min-width: 100%;
            height: 100%;
            position: relative;
        }
        .carousel-slide img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center 18%;
            display: block;
        }
        .carousel-gradient {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(0,0,0,0.05) 30%, rgba(7, 10, 16, 0.95) 100%);
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 16px;
        }
        .slide-title {
            font-size: 17.5px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 3px;
        }
        .slide-subtitle {
            font-size: 11px;
            color: #E2E8F0;
            font-style: italic;
        }
        .carousel-dots {
            position: absolute;
            bottom: 10px;
            right: 16px;
            display: flex;
            gap: 6px;
            z-index: 10;
        }
        .carousel-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
            transition: all 0.3s ease;
        }
        .carousel-dot.active {
            width: 18px;
            border-radius: 10px;
            background: var(--gold-primary);
            box-shadow: 0 0 6px var(--gold-glow);
        }

        /* ==================== 4. DAILY DEVOTIONAL CONTENT (WHATSAPP STATUS) ==================== */
        .daily-section-wrap {
            padding: 14px 0 6px;
            background: linear-gradient(180deg, rgba(20, 28, 46, 0.5) 0%, transparent 100%);
            border-top: 1px solid var(--border-subtle);
            border-bottom: 1px solid var(--border-subtle);
            margin: 10px 0 4px;
        }
        .daily-section-header {
            padding: 0 18px 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .daily-title-box h3 {
            font-size: 15px;
            font-weight: 700;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .daily-title-box p {
            font-size: 10.5px;
            color: var(--gold-light);
            margin: 0;
            font-weight: 600;
        }
        .daily-tag-today {
            background: rgba(229, 169, 60, 0.15);
            border: 1px solid var(--border-gold);
            color: var(--gold-light);
            font-size: 10.5px;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .daily-cards-scroll {
            display: flex;
            gap: 12px;
            overflow-x: auto;
            padding: 4px 18px 10px;
            scrollbar-width: none;
        }
        .daily-cards-scroll::-webkit-scrollbar { display: none; }

        .daily-card {
            position: relative;
            min-width: 150px;
            max-width: 150px;
            height: 235px;
            border-radius: var(--radius-md);
            overflow: hidden;
            background: var(--bg-card);
            border: 1px solid var(--border-gold);
            box-shadow: 0 6px 18px rgba(0,0,0,0.5);
            flex-shrink: 0;
            cursor: pointer;
            transition: transform 0.2s;
        }
        .daily-card:active {
            transform: scale(0.97);
        }
        .daily-card-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
        .daily-card-badge {
            position: absolute;
            top: 8px;
            left: 8px;
            background: rgba(14, 20, 34, 0.9);
            border: 1px solid var(--border-gold);
            color: #fff;
            font-size: 9px;
            font-weight: 800;
            padding: 2px 7px;
            border-radius: 10px;
            backdrop-filter: blur(6px);
            z-index: 2;
        }
        .daily-card-gradient {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, transparent 40%, rgba(7, 10, 16, 0.95) 100%);
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 8px;
            z-index: 2;
        }
        .daily-card-title {
            font-size: 11.5px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 2px;
            line-height: 1.2;
        }
        .daily-card-sub {
            font-size: 9px;
            color: var(--gold-light);
            margin-bottom: 6px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .daily-card-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 4px;
            background: rgba(0,0,0,0.4);
            border-radius: 16px;
            padding: 3px 6px;
        }
        .daily-action-btn {
            background: transparent;
            border: none;
            color: #fff;
            font-size: 12.5px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .daily-action-btn.wa-btn {
            color: #25D366;
            font-size: 14px;
        }

        /* ==================== 5. CIRCLE AVATAR CATEGORIES ==================== */
        .category-avatar-scroll {
            padding: 14px 0 6px;
            overflow-x: auto;
            white-space: nowrap;
            display: flex;
            gap: 14px;
            padding-left: 18px;
            padding-right: 18px;
            scrollbar-width: none;
        }
        .category-avatar-scroll::-webkit-scrollbar { display: none; }
        .avatar-cat-item {
            display: inline-flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            min-width: 64px;
        }
        .avatar-ring {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            padding: 2px;
            background: var(--bg-surface);
            border: 1.5px solid var(--border-subtle);
            transition: all 0.25s ease;
            box-shadow: 0 4px 10px rgba(0,0,0,0.4);
        }
        .avatar-cat-item.active .avatar-ring {
            border-color: var(--gold-primary);
            box-shadow: 0 0 14px var(--gold-glow);
            transform: scale(1.05);
        }
        .avatar-img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            display: block;
        }
        .avatar-name {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
            text-align: center;
            max-width: 68px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .avatar-cat-item.active .avatar-name {
            color: var(--gold-light);
            font-weight: 700;
        }

        /* --- FILTER TABS --- */
        .filter-tab-group {
            display: flex;
            background: var(--bg-surface);
            border-radius: 12px;
            padding: 4px;
            margin: 8px 18px 14px;
            border: 1px solid var(--border-subtle);
        }
        .filter-tab {
            flex: 1;
            text-align: center;
            padding: 7px 0;
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted);
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .filter-tab.active {
            background: var(--gold-primary);
            color: #0E0A03;
            font-weight: 700;
            box-shadow: 0 2px 8px var(--gold-glow);
        }

        /* ==================== 6. WALLPAPER GRID ==================== */
        .section-bar {
            padding: 14px 18px 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .section-bar h2 {
            font-size: 15.5px;
            font-weight: 700;
            color: #fff;
        }
        .section-bar a {
            font-size: 12px;
            color: var(--gold-primary);
            text-decoration: none;
            font-weight: 600;
        }
        .wallpaper-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            padding: 0 16px;
        }
        .card-wall {
            background: var(--bg-card);
            border-radius: var(--radius-md);
            overflow: hidden;
            position: relative;
            border: 1px solid var(--border-subtle);
            box-shadow: 0 4px 14px rgba(0,0,0,0.35);
        }
        .card-thumb-wrap {
            position: relative;
            width: 100%;
            height: 240px;
            background: #0F1523;
            overflow: hidden;
        }
        .card-thumb-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.3s ease;
        }
        
        .badge-live {
            position: absolute;
            top: 8px;
            right: 8px;
            background: var(--live-crimson);
            color: #fff;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 0.8px;
            padding: 3px 8px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            gap: 4px;
            box-shadow: 0 0 10px var(--live-glow);
            z-index: 2;
        }
        .badge-live-pulse {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: #fff;
            animation: liveBlink 1s infinite alternate;
        }
        @keyframes liveBlink { from { opacity: 0.3; } to { opacity: 1; } }

        .card-footer-pill {
            position: absolute;
            bottom: 8px;
            left: 50%;
            transform: translateX(-50%);
            width: 90%;
            padding: 4px 8px;
            background: rgba(14, 20, 34, 0.92);
            backdrop-filter: blur(10px);
            border-radius: 24px;
            border: 1px solid rgba(255, 255, 255, 0.12);
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 3;
        }
        .pill-btn {
            background: transparent;
            border: none;
            color: #fff;
            font-size: 15px;
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }
        .pill-btn.btn-fav.active {
            color: var(--live-crimson);
        }
        .pill-btn-set {
            background: linear-gradient(135deg, var(--gold-light), var(--gold-primary));
            color: #0F0B02;
            font-size: 11px;
            font-weight: 800;
            border: none;
            border-radius: 16px;
            padding: 3px 10px;
            cursor: pointer;
        }
        .pill-btn-set.is-live-btn {
            background: linear-gradient(135deg, #FF6B8B, var(--live-crimson));
            color: #fff;
        }

        /* ==================== 7. PREVIEW MODAL (ZERO BLUR SMOOTH HD) ==================== */
        #preview-modal {
            position: fixed;
            inset: 0;
            z-index: 5000;
            background: #000;
            display: none;
            flex-direction: column;
            justify-content: space-between;
            overflow: hidden;
        }
        .preview-viewport {
            position: absolute;
            inset: 0;
            z-index: 1;
            background: #070A10;
        }
        .preview-layer-poster,
        .preview-layer-live {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            image-rendering: -webkit-optimize-contrast;
            transition: filter 0.3s ease;
        }
        .preview-layer-live {
            z-index: 2;
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        .preview-layer-live.loaded {
            opacity: 1;
        }

        .preview-topbar {
            position: relative;
            z-index: 10;
            padding: 16px 18px;
            background: linear-gradient(180deg, rgba(0,0,0,0.85) 0%, transparent 100%);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .preview-bottombar {
            position: relative;
            z-index: 10;
            padding: 20px 20px calc(20px + var(--safe-bottom));
            background: linear-gradient(0deg, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.6) 70%, transparent 100%);
            display: flex;
            flex-direction: column;
            gap: 14px;
        }
        .preview-quick-actions {
            display: flex;
            justify-content: space-around;
            align-items: center;
        }
        .preview-action-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            color: #fff;
            cursor: pointer;
        }
        .preview-action-item span {
            font-size: 11px;
            color: var(--text-muted);
        }
        .btn-set-wallpaper-main {
            width: 100%;
            background: linear-gradient(135deg, var(--gold-light), var(--gold-primary));
            color: #120E03;
            font-size: 14px;
            font-weight: 800;
            border: none;
            padding: 14px;
            border-radius: 30px;
            box-shadow: 0 4px 18px var(--gold-glow);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
        }
        .btn-set-wallpaper-main.is-live {
            background: linear-gradient(135deg, #FF6B8B, var(--live-crimson));
            color: #fff;
            box-shadow: 0 4px 18px var(--live-glow);
        }

        /* ==================== 8. SET WALLPAPER BOTTOM SHEET ==================== */
        .sheet-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(5px);
            z-index: 6000;
            display: none;
        }
        #wallpaper-sheet {
            position: fixed;
            bottom: -100%;
            left: 0;
            right: 0;
            background: var(--bg-surface);
            border-top-left-radius: var(--radius-xl);
            border-top-right-radius: var(--radius-xl);
            padding: 22px 20px calc(22px + var(--safe-bottom));
            z-index: 6001;
            border-top: 1px solid var(--border-gold);
            box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.8);
            transition: bottom 0.25s cubic-bezier(0.1, 0.9, 0.2, 1);
        }
        #wallpaper-sheet.active {
            bottom: 0;
        }
        .sheet-option-item {
            width: 100%;
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            padding: 14px 16px;
            border-radius: var(--radius-md);
            color: #fff;
            font-size: 13.5px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 10px;
            cursor: pointer;
        }
        .sheet-option-item:active {
            background: var(--gold-primary);
            color: #0E0A03;
        }

        /* ==================== 9. ULTRA-MAGIC INSTANT LOADER ==================== */
        #magic-loader-overlay {
            position: fixed;
            inset: 0;
            background: rgba(4, 7, 14, 0.92);
            backdrop-filter: blur(18px);
            z-index: 99999;
            display: none;
            align-items: center;
            justify-content: center;
            flex-direction: column;
        }
        .magic-card {
            background: radial-gradient(circle at 50% 30%, #1A253C 0%, #0D1322 100%);
            border: 1.5px solid var(--border-gold);
            border-radius: 28px;
            width: 86%;
            max-width: 320px;
            padding: 34px 22px 28px;
            text-align: center;
            box-shadow: 0 20px 50px rgba(0,0,0,0.9), 0 0 30px var(--gold-glow);
            position: relative;
            overflow: hidden;
            animation: magicPop 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        @keyframes magicPop {
            from { transform: scale(0.88); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }
        .magic-aura-glow {
            position: absolute;
            top: 40px;
            left: 50%;
            transform: translateX(-50%);
            width: 110px;
            height: 110px;
            background: radial-gradient(circle, rgba(229, 169, 60, 0.4) 0%, transparent 70%);
            filter: blur(15px);
            pointer-events: none;
        }
        .magic-orbit-container {
            position: relative;
            width: 90px;
            height: 90px;
            margin: 0 auto 18px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .magic-ring-outer {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            border: 2px dashed var(--gold-primary);
            animation: rotateOrbit 7s linear infinite;
        }
        .magic-ring-inner {
            position: absolute;
            inset: 8px;
            border-radius: 50%;
            border: 1.5px dotted var(--gold-light);
            animation: counterRotateOrbit 5s linear infinite;
        }
        @keyframes rotateOrbit { 100% { transform: rotate(360deg); } }
        @keyframes counterRotateOrbit { 100% { transform: rotate(-360deg); } }

        .magic-center-emblem {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            border: 1.5px solid var(--gold-primary);
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 16px var(--gold-glow);
            animation: magicPulse 1.8s ease-in-out infinite alternate;
            z-index: 2;
            background: #0B101D;
        }
        .magic-center-emblem img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        @keyframes magicPulse {
            from { transform: scale(0.92); box-shadow: 0 0 8px var(--gold-glow); }
            to { transform: scale(1.08); box-shadow: 0 0 24px rgba(229, 169, 60, 0.6); }
        }

        .magic-percentage {
            font-size: 34px;
            font-weight: 800;
            color: #FFFFFF;
            letter-spacing: -0.5px;
            text-shadow: 0 0 14px var(--gold-glow);
            margin-bottom: 4px;
        }
        .magic-status-pill {
            display: inline-block;
            font-size: 11.5px;
            color: var(--text-muted);
            line-height: 1.4;
            min-height: 24px;
            margin-bottom: 18px;
            font-weight: 500;
            word-break: break-word;
        }

        .magic-bar-container {
            width: 100%;
            height: 8px;
            background: rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.12);
            position: relative;
        }
        .magic-bar-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, var(--gold-light), var(--gold-primary), #FF7B54);
            border-radius: 20px;
            transition: width 0.15s ease;
            box-shadow: 0 0 12px var(--gold-glow);
            position: relative;
        }
        .magic-bar-fill::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.7), transparent);
            animation: magicShimmer 1.5s infinite;
        }
        @keyframes magicShimmer {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }

        /* ==================== 10. GLOBAL MORE & ABOUT SCREEN ==================== */
        .more-hero {
            text-align: center;
            padding: 30px 20px 20px;
        }
        .more-logo-frame {
            width: 88px;
            height: 88px;
            margin: 0 auto 14px;
            border-radius: 50%;
            border: 2px solid var(--gold-primary);
            box-shadow: 0 0 25px var(--gold-glow);
            overflow: hidden;
            background: #0B101D;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .more-logo-frame img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
        .more-menu-group {
            background: var(--bg-surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-lg);
            margin: 0 18px 16px;
            overflow: hidden;
        }
        .more-menu-item {
            padding: 15px 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--border-subtle);
            color: #fff;
            font-size: 13.5px;
            cursor: pointer;
        }
        .more-menu-item:last-child {
            border-bottom: none;
        }
        .more-menu-left {
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .more-menu-left i {
            font-size: 18px;
            color: var(--gold-primary);
            width: 22px;
        }

        /* CUSTOM IN-APP CONFIRMATION MODAL */
        #confirm-clear-modal {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.85);
            backdrop-filter: blur(8px);
            z-index: 9100;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .confirm-card {
            background: var(--bg-surface);
            border: 1.5px solid var(--border-gold);
            border-radius: var(--radius-xl);
            padding: 26px 20px;
            max-width: 320px;
            width: 100%;
            text-align: center;
            box-shadow: 0 20px 45px rgba(0,0,0,0.9);
            animation: magicPop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .confirm-card i {
            font-size: 36px;
            color: var(--live-crimson);
            margin-bottom: 10px;
            display: inline-block;
        }
        .confirm-card h4 {
            font-size: 17px;
            color: #fff;
            margin-bottom: 6px;
            font-weight: 700;
        }
        .confirm-card p {
            font-size: 12.5px;
            color: var(--text-muted);
            margin-bottom: 20px;
            line-height: 1.5;
        }
        .confirm-actions {
            display: flex;
            gap: 10px;
        }
        .btn-confirm-yes {
            flex: 1;
            background: linear-gradient(135deg, #FF4757, #FF2E63);
            color: #fff;
            border: none;
            border-radius: 20px;
            padding: 10px 0;
            font-size: 12.5px;
            font-weight: 800;
            cursor: pointer;
            box-shadow: 0 3px 12px var(--live-glow);
        }
        .btn-confirm-no {
            flex: 1;
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            color: var(--text-main);
            border-radius: 20px;
            padding: 10px 0;
            font-size: 12.5px;
            font-weight: 700;
            cursor: pointer;
        }

        /* ABOUT MODAL */
        #about-modal {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.85);
            backdrop-filter: blur(8px);
            z-index: 9000;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .about-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-gold);
            border-radius: var(--radius-xl);
            padding: 24px;
            max-width: 360px;
            width: 100%;
            text-align: center;
            box-shadow: 0 20px 40px rgba(0,0,0,0.8);
        }
        .about-card h3 {
            font-size: 19px;
            color: #fff;
            margin-bottom: 4px;
        }
        .about-card p {
            font-size: 12px;
            color: var(--text-muted);
            line-height: 1.6;
            margin-bottom: 16px;
        }
        .about-btn-close {
            background: linear-gradient(135deg, var(--gold-light), var(--gold-primary));
            color: #0E0A03;
            border: none;
            border-radius: 20px;
            padding: 8px 24px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
        }

        /* ==================== 11. FESTIVALS (FIXED & LOGO INTEGRATED) ==================== */
        .fest-left-group {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .fest-card-logo {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            border: 1.5px solid var(--gold-primary);
            box-shadow: 0 0 10px var(--gold-glow);
            object-fit: cover;
            flex-shrink: 0;
        }
        .festival-card {
            background: linear-gradient(135deg, #182236 0%, #0E1422 100%);
            border: 1px solid var(--border-gold);
            border-radius: var(--radius-md);
            padding: 14px 16px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
            transition: all 0.2s;
        }
        .festival-card:active {
            transform: scale(0.98);
        }
        .fest-info h4 {
            font-size: 14.5px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 3px;
        }
        .fest-info p {
            font-size: 11px;
            color: var(--gold-primary);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .fest-badge {
            background: rgba(229, 169, 60, 0.15);
            color: var(--gold-light);
            border: 1px solid var(--border-gold);
            border-radius: 20px;
            padding: 5px 12px;
            font-size: 11px;
            font-weight: 700;
            flex-shrink: 0;
        }

        /* ==================== 12. BOTTOM NAVIGATION ==================== */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(7, 10, 16, 0.95);
            backdrop-filter: blur(20px);
            border-top: 1px solid var(--border-subtle);
            height: calc(60px + var(--safe-bottom));
            padding-bottom: var(--safe-bottom);
            display: flex;
            justify-content: space-around;
            align-items: center;
            z-index: 4000;
        }
        .nav-item {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 4px;
            color: var(--text-muted);
            cursor: pointer;
        }
        .nav-item i {
            font-size: 18px;
        }
        .nav-item span {
            font-size: 10px;
            font-weight: 600;
        }
        .nav-item.active {
            color: var(--gold-primary);
        }

        .view-page { display: none; }
        .view-page.active-page { display: block; }
        
        #loader-overlay {
            position: fixed;
            inset: 0;
            background: var(--bg-base);
            z-index: 8000;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        .lotus-spinner {
            width: 44px;
            height: 44px;
            border: 3px solid rgba(229, 169, 60, 0.15);
            border-top-color: var(--gold-primary);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin-bottom: 12px;
        }
        @keyframes spin { 100% { transform: rotate(360deg); } }

        .empty-placeholder {
            text-align: center;
            padding: 60px 20px;
            width: 100%;
        }
        .empty-placeholder i {
            font-size: 50px;
            color: var(--text-sub);
            margin-bottom: 10px;
            display: inline-block;
        }
    </style>
</head>
<body>

    <!-- 1. TOAST NOTIFICATION -->
    <div id="toast-notification">
        <i class="bi bi-check2-circle text-success" style="font-size:18px;"></i>
        <span id="toast-msg">Saved to Device Gallery</span>
    </div>

    <!-- 2. ULTRA-MAGIC INSTANT LOADER -->
    <div id="magic-loader-overlay">
        <div class="magic-card">
            <div class="magic-aura-glow"></div>
            <div class="magic-orbit-container">
                <div class="magic-ring-outer" id="magic-outer-ring"></div>
                <div class="magic-ring-inner"></div>
                <div class="magic-center-emblem" id="magic-center-icon">
                    <img src="https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEh-bX10dFrWfQUjQnPHiahsLtuPOAwPE130p8VBPsvFiBm1QCVVFNAFJCnyy5UT9Dv4tNG0LxMZg91pF4m8IRF7ttpmhFGQFATCTnTlL9CljnS1BcYSFsxzrvVwgw79Jr_yNxrGEBg4UHDFYWzra6uogVJfPg_V6fRaTNrAkp-Oty6jIa2HvZnyHxjOkHJf/s200/1000303466.png" alt="DevDarshan">
                </div>
            </div>
            <div class="magic-percentage" id="magic-pct-text">0%</div>
            <div class="magic-status-pill" id="magic-status-text">⚡ Downloading Ultra HD...</div>
            <div class="magic-bar-container">
                <div class="magic-bar-fill" id="magic-bar-fill"></div>
            </div>
        </div>
    </div>

    <!-- 3. SET WALLPAPER BOTTOM SHEET -->
    <div class="sheet-backdrop" id="sheet-backdrop" onclick="closeWallpaperSheet()"></div>
    <div id="wallpaper-sheet">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
            <div>
                <h3 style="font-size:16px; font-weight:700; color:#fff;">Set Wallpaper</h3>
                <p style="font-size:11px; color:var(--text-muted); margin:0;">Instant One-Tap Setup</p>
            </div>
            <i class="bi bi-x-circle-fill" style="font-size:22px; color:var(--text-muted); cursor:pointer;" onclick="closeWallpaperSheet()"></i>
        </div>
        <div class="sheet-option-item" onclick="executeSetWallpaper(1)">
            <span><i class="bi bi-phone me-2" style="color:var(--gold-primary);"></i> Home Screen</span>
            <i class="bi bi-chevron-right" style="color:var(--text-sub);"></i>
        </div>
        <div class="sheet-option-item" onclick="executeSetWallpaper(2)">
            <span><i class="bi bi-lock me-2" style="color:#60A5FA;"></i> Lock Screen</span>
            <i class="bi bi-chevron-right" style="color:var(--text-sub);"></i>
        </div>
        <div class="sheet-option-item" onclick="executeSetWallpaper(3)">
            <span><i class="bi bi-layers-half me-2" style="color:#34D399;"></i> Home & Lock Screen</span>
            <i class="bi bi-chevron-right" style="color:var(--text-sub);"></i>
        </div>
    </div>

    <!-- 4. FULLSCREEN PREVIEW (HIGH RES ZERO BLUR) -->
    <div id="preview-modal">
        <div class="preview-viewport">
            <img id="preview-poster" class="preview-layer-poster" src="" alt="Poster">
            <img id="preview-live-media" class="preview-layer-live" src="" alt="Live Visual">
        </div>

        <div class="preview-topbar">
            <div class="icon-btn-round" onclick="closePreviewModal()">
                <i class="bi bi-arrow-left"></i>
            </div>
            <div id="preview-live-pill" class="badge-live" style="display:none; position:static;">
                <span class="badge-live-pulse"></span> LIVE
            </div>
            <div style="display:flex; gap:8px;">
                <div class="icon-btn-round" id="preview-fav-btn" onclick="togglePreviewFav()">
                    <i class="bi bi-heart"></i>
                </div>
                <div class="icon-btn-round" onclick="shareCurrentWallpaper()">
                    <i class="bi bi-share"></i>
                </div>
            </div>
        </div>

        <div class="preview-bottombar">
            <div class="preview-quick-actions">
                <div class="preview-action-item" onclick="showInfoToast()">
                    <i class="bi bi-info-circle" style="font-size:20px;"></i>
                    <span>Info</span>
                </div>
                <div class="preview-action-item" onclick="downloadCurrentWallpaper()">
                    <i class="bi bi-download" style="font-size:20px; color:var(--gold-light);"></i>
                    <span>Download</span>
                </div>
                <div class="preview-action-item" onclick="shareToWhatsAppCurrent()">
                    <i class="bi bi-whatsapp" style="font-size:20px; color:#25D366;"></i>
                    <span>WhatsApp</span>
                </div>
            </div>
            <button class="btn-set-wallpaper-main" id="preview-set-btn" onclick="handlePreviewSetClick()">
                <i class="bi bi-image"></i> Set Wallpaper
            </button>
        </div>
    </div>

    <!-- 5. ABOUT US MODAL -->
    <div id="about-modal" onclick="closeAboutModal()">
        <div class="about-card" onclick="event.stopPropagation()">
            <div class="more-logo-frame" style="width:76px; height:76px; margin-bottom:12px;">
                <img src="https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEh-bX10dFrWfQUjQnPHiahsLtuPOAwPE130p8VBPsvFiBm1QCVVFNAFJCnyy5UT9Dv4tNG0LxMZg91pF4m8IRF7ttpmhFGQFATCTnTlL9CljnS1BcYSFsxzrvVwgw79Jr_yNxrGEBg4UHDFYWzra6uogVJfPg_V6fRaTNrAkp-Oty6jIa2HvZnyHxjOkHJf/s300/1000303466.png" alt="DevDarshan Logo">
            </div>
            <h3 class="font-devotional">DevDarshan</h3>
            <span style="font-size:11px; color:var(--gold-primary); font-weight:700; display:block; margin-bottom:12px;">Hindu Wallpaper • v3.8.0</span>
            <p>
                Created with pure devotion for all Sanatan & ISKCON devotees worldwide. 100% Free Ultra HD & Live Wallpapers of Sri Krishna, Mahadev, Radha Rani, Gaura Nitai and Sacred Temples.
            </p>
            <div style="border-top:1px solid var(--border-subtle); padding-top:10px; margin-bottom:14px; font-size:11px; color:var(--text-sub);">
                Crafted with love by <strong>Dev Santosh Studio</strong><br>
                <a href="mailto:devsantosh.tech@gmail.com" style="color:var(--gold-primary); text-decoration:none;">devsantosh.tech@gmail.com</a>
            </div>
            <button class="about-btn-close" onclick="closeAboutModal()">Jai Shree Krishna</button>
        </div>
    </div>

    <!-- 6. CUSTOM IN-APP CONFIRMATION MODAL -->
    <div id="confirm-clear-modal" onclick="closeClearModal()">
        <div class="confirm-card" onclick="event.stopPropagation()">
            <i class="bi bi-trash3-fill"></i>
            <h4 id="confirm-clear-title">Clear Favorites?</h4>
            <p id="confirm-clear-desc">Do you really want to remove all saved favorite wallpapers?</p>
            <div class="confirm-actions">
                <button class="btn-confirm-no" onclick="closeClearModal()">Cancel</button>
                <button class="btn-confirm-yes" onclick="executeConfirmedClear()">Yes, Clear</button>
            </div>
        </div>
    </div>

    <!-- 7. APP HEADER -->
    <header class="app-header">
        <div class="header-brand">
            <div class="brand-logo-wrap">
                <img src="https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEh-bX10dFrWfQUjQnPHiahsLtuPOAwPE130p8VBPsvFiBm1QCVVFNAFJCnyy5UT9Dv4tNG0LxMZg91pF4m8IRF7ttpmhFGQFATCTnTlL9CljnS1BcYSFsxzrvVwgw79Jr_yNxrGEBg4UHDFYWzra6uogVJfPg_V6fRaTNrAkp-Oty6jIa2HvZnyHxjOkHJf/s200/1000303466.png" class="brand-logo-img" alt="DevDarshan">
            </div>
            <div class="brand-text">
                <h1 class="font-devotional">DevDarshan</h1>
                <p id="header-tagline">Hindu Wallpaper • Divine Visuals</p>
            </div>
        </div>
        <div class="header-actions">
            <div class="badge-iskcon-pill" id="iskcon-toggle-btn" onclick="toggleIskconDevoteeMode()">
                <i class="bi bi-stars"></i> <span id="iskcon-pill-text">ISKCON</span>
            </div>
            <div class="icon-btn-round" onclick="toggleSearchBox()">
                <i class="bi bi-search"></i>
            </div>
        </div>
    </header>

    <!-- Slide Search Box -->
    <div id="search-box-bar">
        <div class="search-inner">
            <i class="bi bi-search" style="color:var(--text-muted); font-size:14px;"></i>
            <input type="text" id="main-search-input" placeholder="Search Krishna, Mahadev, Radha, Prabhupada..." onkeyup="handleSearchInput(event)">
            <i class="bi bi-x-circle" style="color:var(--text-muted); cursor:pointer;" onclick="toggleSearchBox()"></i>
        </div>
    </div>

    <!-- ==================== VIEW 1: HOME ==================== -->
    <div id="view-home" class="view-page active-page">
        <!-- Banner Slider -->
        <section class="slider-section">
            <div class="slider-header">
                <h3 id="darshan-banner-heading">Today's Divine Darshan</h3>
                <span id="slider-date-text">Divine Darshan</span>
            </div>
            <div class="hero-carousel-container">
                <div class="carousel-track" id="carousel-track">
                    <div class="carousel-slide">
                        <img src="https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgiA01mOhZlGuS9DzgRRyR8vo8ZBkSS71LGeMcpcmMxvC5-LpXg84UdOF4gqIYQnjUDKKR6G2aFEw-6bgcDNNUUHIuh7BDznsz_XvP4Ea-Ptw536B77RV7aagi8gA8GidociRvkrOZyWU_21QTJudX-XrNBAjCcGgFbatJMON2iYRRA9Qw2X3wEzVza9fJp/s1000/1000310869.png" alt="Divine Darshan">
                        <div class="carousel-gradient">
                            <div class="slide-title font-devotional">Shree Radha Krishna</div>
                            <div class="slide-subtitle">"Always remember Me with pure devotion and love."</div>
                        </div>
                    </div>
                    <div class="carousel-slide">
                        <img src="https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgWEuxrF77OZSFg4kzFs0BF7eCTB7FdY-VesQ_XhKMrlUuxhb237JvHGOi4eFCsJGTYpLA7SQofdMU8gSQwH9I4U5RnlfW_MmP7tz8GgsGrzBimCFLVq63TByty2twAaDCXROGjXCL6Uqg4WOW2IC2nmhh34wNKM-RNMKPUQV5cVq2TleD9UsC68ZZPwYDm/s1000/1000310870.png" alt="Vrindavan Darshan">
                        <div class="carousel-gradient">
                            <div class="slide-title font-devotional">Vrindavan Bihari</div>
                            <div class="slide-subtitle">"He who offers to Me with love will receive eternal peace."</div>
                        </div>
                    </div>
                    <div class="carousel-slide">
                        <img src="https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgKvcK0wesFjqlqegekMORMBQXBQMxtYVzoJOo6hpJ7CPJp2P8hb6dlS7Pi16ylQaa_pwLMGQ6p8P8O627-hi_3aiZrpDMv2vUhkDEOSSNoyqVZCupPdoi146g7eNQpAJC-ticKfPDi3qp13HA_7ly6gVNl6iftOZAmYb1ZoWvsdDg4FJ68bsTDwMvWGBbZ/s1000/1000310871.png" alt="Mahadev Darshan">
                        <div class="carousel-gradient">
                            <div class="slide-title font-devotional">Neelkanth Mahadev</div>
                            <div class="slide-subtitle">"Supreme peace and eternal consciousness."</div>
                        </div>
                    </div>
                </div>
                <div class="carousel-dots" id="carousel-dots">
                    <div class="carousel-dot active"></div>
                    <div class="carousel-dot"></div>
                    <div class="carousel-dot"></div>
                </div>
            </div>
        </section>

        <!-- 🌟 DAILY DEVOTIONAL CONTENT (WHATSAPP STATUS & DAILY HABIT LOOP) -->
        <section class="daily-section-wrap">
